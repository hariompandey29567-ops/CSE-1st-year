#include <stdio.h>
int main()

{
    int a,temp,rem,rev=0;
    printf ("enter a number");
    scanf ("%d",&a);
    temp=a;
    while (a!=0)
        {
            rem=a%10;
            rev = (rev*10)+rem;
            a/=10;
        }
    if (temp==rev)
    { 
        printf ("it's a pallindrome");
    }
    else
    {
          printf ("it's not a pallindrome");
    }
}
